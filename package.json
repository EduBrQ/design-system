{
  "name": "@edubrq/design-system",
  "version": "0.1.0",
  "private": false,
  "type": "module",
  "description": "Design system white-label compartilhado entre AquaFarm (ecamarao) e Oficina Inteligente.",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
